# Copia este archivo como .env en la raíz de atlas_core.
# No compartas ni subas .env a Git o Drive público.
ATLAS_TELEGRAM_ENABLED=false
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_POLL_TIMEOUT=30
ATLAS_TELEGRAM_LINK_CODE_TTL_SECONDS=600
ATLAS_TELEGRAM_RATE_LIMIT_PER_MINUTE=20
ATLAS_TELEGRAM_MAX_INPUT_CHARACTERS=8000
ATLAS_TELEGRAM_MAX_CONCURRENT_OPERATIONS=4
ATLAS_TELEGRAM_PROCESSING_TIMEOUT_SECONDS=120
ATLAS_TELEGRAM_SESSION_TTL_SECONDS=86400
ATLAS_TELEGRAM_PROGRESS_DELAY_SECONDS=4

# STT local. Nunca habilites descargas automáticas sin revisar antes el modelo.
ATLAS_STT_MODEL=small
ATLAS_STT_DEVICE=auto
ATLAS_STT_COMPUTE_TYPE=auto
ATLAS_STT_TIMEOUT=90
ATLAS_STT_MAX_AUDIO_SECONDS=180
ATLAS_STT_LANGUAGE_HINT=
ATLAS_STT_ALLOW_MODEL_DOWNLOAD=false
# Experimental: el benchmark del hardware actual fue más lento en persistente.
ATLAS_KOKORO_PERSISTENT=false

# Roles locales de IA. Los nombres físicos se configuran únicamente aquí o
# mediante el registro central; Telegram, CLI y voz solo conocen Atlas Core.
ATLAS_AI_FAST_MODEL=qwen2.5:7b
ATLAS_AI_REASONING_MODEL=qwen2.5:14b
ATLAS_AI_DEEP_MODEL=qwen3:30b
ATLAS_AI_ROUTE=auto
ATLAS_AI_EXTERNAL_ENABLED=false
ATLAS_KNOWLEDGE_DATA_DIR=data/knowledge

# Datos privados. Copia los JSON ficticios de examples/private_runtime/ a una
# carpeta local no versionada y cambia estas rutas para tu instalación.
ATLAS_PRIVATE_DATA_DIR=data/private
ATLAS_IDENTITY_DATA_DIR=data/private/identity
ATLAS_USER_DATA_DIR=data/private/users
ATLAS_FAMILY_DATA_FILE=data/private/family.json
ATLAS_USER_PROFILES_FILE=data/private/users.json
ATLAS_HOUSEHOLD_DATA_FILE=data/private/households.json
ATLAS_ASSISTANT_PREFERENCES_PATH=data/private/assistant/preferences.json
